# Obligatoire
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel (Birdeye ameliore la qualite des donnees market, sinon DexScreener seul suffit)
BIRDEYE_API_KEY=

# Optionnel, uniquement si wallet_tracking.enabled=true dans config.json
# Le RPC public est rate-limite ; pour un usage intensif utilise un RPC dedie (Helius, QuickNode...)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optionnel, uniquement si tu utilises le X tracker via twscrape
TWSCRAPE_DB=x_accounts.db
